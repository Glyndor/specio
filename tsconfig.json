{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["chrome"],
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "rootDir": "internal",
        "outDir": "dist",
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "include": ["internal"]
}
