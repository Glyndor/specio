{
    "manifest_version": 3,
    "name": "__MSG_extensionName__",
    "version": "0.1.0",
    "description": "__MSG_extensionDescription__",
    "default_locale": "en",
    "action": {
        "default_popup": "popup/index.html",
        "default_title": "__MSG_extensionName__"
    },
    "background": {
        "service_worker": "background/index.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content/index.js"],
            "run_at": "document_idle"
        }
    ]
}
